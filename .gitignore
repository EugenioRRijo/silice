# Entornos y caches de Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
reporte-pruebas.xml

# Bases de datos locales (SQLite se regenera con scripts/seed.py)
*.db
*.sqlite
*.sqlite3

# Modelos y artefactos de ML pesados
ml/**/*.bin
ml/**/*.joblib
ml/**/*.pkl

# Secretos y configuracion local
.env
.env.*

# Sistema operativo / Office (archivos de bloqueo de Word y Excel en OneDrive)
Thumbs.db
.DS_Store
~$*

# Worktrees de los sprints (NORMAS.md §3)
.worktrees/

# Salida de la prueba descartable del editor de tablas (SF0)
scripts/_salida_prueba_editor.log
coverage.json

# Cifra de RNF-11 que deja scripts/medir_rnf11.py (la lee la meta S9)
scripts/_salida_rnf11.json

# Carpeta de datos de desarrollo de Silice: SILICE_DATOS por defecto (maestro §4.2; spec S5 §5.3)
data/instalacion.db
data/codigo_instalacion.txt
data/paquetes/
data/casos/
data/respaldos/
data/eventos_perdidos_*.json
# Copias de trabajo de una migracion interrumpida (operacion.base_datos)
*.migrando

# Bases de prueba de cada version, con su ficha (RV-3, PRU-H15): SI se versionan
!tests/fixtures/bases/*/*.db

# Configuración, registros y estado del servidor de desarrollo (S5-2)
data/config/
data/registros/
data/estado/

# Cifra de la medicion de RNF-15 (la lee la meta de la 0.7.0)
scripts/_salida_rnf15.json

# Construccion del instalador, publicacion y salidas de la prueba de humo (S5-3, S5-4)
build/
publicacion/
humo-salida/

# Presupuestos reales de clientes: confidenciales, nunca al repositorio (Silice 1.5, V-D3, 2026-10-13)
# En cualquier subcarpeta de docs/auditoria/ y con la extension en cualquier capitalizacion (.XLSX):
# git distingue mayusculas en Linux. La meta D4 (scripts/meta_datos.py) vigila ademas toda hoja de
# calculo o PDF versionado fuera de su lista blanca.
docs/auditoria/**/*.[xX][lL][sS]
docs/auditoria/**/*.[xX][lL][sS][xXmMbB]
docs/auditoria/**/*.[pP][dD][fF]
data/confidencial/

# Corridas del piloto del experimento del asistente (S4.4): son de desarrollo y no se versionan.
# Los resultados de la evaluacion (docs/resultados_asistente_*.json) SI se versionan en T20.
docs/piloto_*.json
docs/piloto_asistente_corridas.json
